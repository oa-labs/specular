<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/todo_widget_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal">
    <TextView android:id="@+id/todo_widget_complete" android:layout_width="36dp" android:layout_height="40dp" android:gravity="center" android:text="○" android:textColor="#b45309" android:textSize="27sp" android:contentDescription="Complete to-do" />
    <LinearLayout android:id="@+id/todo_widget_content" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/todo_widget_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:textColor="#1f2937" android:textSize="15sp" />
        <TextView android:id="@+id/todo_widget_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#92400e" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
